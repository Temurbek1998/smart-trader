# Claude API kaliti: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Baza. PostgreSQL + TimescaleDB (docker compose up -d bilan ishga tushadi).
# Bo'sh qoldirilsa, sinov uchun SQLite fayl ishlatiladi.
DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5432/smart_trader

# Narx manbasi: mt5 (Windows + MT5 terminali), twelvedata (Vercel uchun) yoki yahoo (sinov uchun)
DATA_PROVIDER=mt5
# twelvedata uchun kalit: https://twelvedata.com
TWELVEDATA_API_KEY=
SYMBOL=XAUUSD

# MT5 demo hisob (terminal allaqachon kirgan bo'lsa bo'sh qoldirish mumkin)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Claude modellari
ANALYST_MODEL=claude-opus-5-5
MONITOR_MODEL=claude-haiku-5-5
ANALYST_EFFORT=high

# Signal qoidalari
MIN_CONFIDENCE=0.7
# Kunlik Claude xarajati chegarasi (USD)
DAILY_COST_LIMIT_USD=20

# Demo savdo
PAPER_BALANCE=10000
RISK_PER_TRADE=0.01
EXECUTE_ON_MT5=false

# Rejalashtiruvchi (daqiqa)
MONITOR_EVERY_MIN=5

# Web panelga kirish (bo'sh bo'lsa parol so'ralmaydi; serverda albatta to'ldiring)
WEB_USER=admin
WEB_PASSWORD=
# Fon rejalashtiruvchini web bilan birga ishga tushirish
RUN_SCHEDULER=true

# Vercel Cron so'rovlarini tasdiqlash uchun maxfiy kalit (uzun tasodifiy satr)
CRON_SECRET=
